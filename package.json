{
  "name": "kerenor",
  "version": "0.1.0",
  "private": true,
  "description": "קרן אור — ניהול מבצעים והקצאת ועידות (RTL, Material UI, design-lead)",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typescript": "tsc -b",
    "build:packages": "pnpm -F @mui/types build && pnpm -F @mui/utils build && pnpm -F @mui/styled-engine build && pnpm -F @mui/private-theming build && pnpm -F @mui/system build && pnpm -F @mui/material build",
    "postinstall": "pnpm build:packages"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "workspace:^",
    "@mui/styled-engine": "workspace:^",
    "@mui/system": "workspace:^",
    "@mui/x-date-pickers": "^7.29.4",
    "@studiongsoft/design-lead": "github:studiongsoft/design-lead",
    "axios": "^1.9.0",
    "dayjs": "^1.11.21",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.56.4",
    "react-router-dom": "^7.6.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-constant-elements": "^7.27.1",
    "@mui/internal-code-infra": "0.0.4-canary.45",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "10.33.4"
  }
}
